{
  "name": "obsidian-docs-publisher",
  "version": "1.0.0",
  "description": "Publish SOP documentation to GitLab from Obsidian, over SSH",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "release": "npm run build && node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "5.2.0",
    "@typescript-eslint/parser": "5.2.0",
    "builtin-modules": "3.2.0",
    "esbuild": "0.13.12",
    "obsidian": "1.13.1",
    "tslib": "2.4.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
