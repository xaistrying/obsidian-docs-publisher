{
  "name": "obsidian-docs-publisher",
  "version": "0.1.0",
  "description": "Publish SOP documentation directly to GitLab from Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node esbuild.config.mjs production"
  },
  "devDependencies": {
    "@types/node": "16.11.6",
    "@typescript-eslint/eslint-plugin": "5.2.0",
    "@typescript-eslint/parser": "5.2.0",
    "builtin-modules": "3.2.0",
    "esbuild": "0.13.12",
    "obsidian": "1.13.1",
    "tslib": "2.4.0",
    "typescript": "^7.0.2"
  }
}
