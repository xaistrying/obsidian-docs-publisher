{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "commonjs",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7"
    ],
    "strict": true
  },
  "include": [
    "**/*.ts"
  ]
}
